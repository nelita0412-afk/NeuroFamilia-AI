generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DevelopmentStage {
  EARLY_CHILDHOOD
  MIDDLE_CHILDHOOD
  ADOLESCENCE
}

enum PersonRole {
  CHILD
  ADOLESCENT
  YOUNG
  MOTHER
  FATHER
  TUTOR
  PROFESSIONAL
  ADMINISTRATOR
}

enum RelationshipType {
  CHILD
  ADOLESCENT
  YOUNG
  MOTHER
  FATHER
  TUTOR
  PROFESSIONAL
  CAREGIVER
  SIBLING
  OTHER
}

enum PermissionAction {
  READ_PROFILE
  WRITE_PROFILE
  READ_FAMILY
  WRITE_FAMILY
  READ_GROWTH
  WRITE_GROWTH
}

model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  person Person?
}

model Person {
  id        String     @id @default(cuid())
  firstName String
  lastName  String
  birthDate DateTime?
  role      PersonRole @default(TUTOR)

  accountId String? @unique
  account   Account? @relation(fields: [accountId], references: [id])

  families FamilyMember[]
  profiles Profile[]

  grantedPermissions  PermissionGrant[] @relation("GrantedPermissions")
  subjectPermissions  PermissionGrant[] @relation("SubjectPermissions")

  createdAt DateTime @default(now())
}

model FamilyGroup {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members FamilyMember[]
  profiles Profile[]
  permissionGrants PermissionGrant[]
}

model FamilyMember {
  id String @id @default(cuid())

  familyId String
  personId String

  relationship RelationshipType

  family FamilyGroup @relation(fields: [familyId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@unique([familyId, personId])
}

model Profile {
  id String @id @default(cuid())

  familyId String
  personId String?

  fullName String

  birthDate DateTime

  developmentStage DevelopmentStage

  person Person? @relation(fields: [personId], references: [id])
  family FamilyGroup @relation(fields: [familyId], references: [id])

  observations GrowthObservation[]
  permissionGrants PermissionGrant[]

  createdAt DateTime @default(now())
}

model GrowthObservation {
  id String @id @default(cuid())

  profileId String

  category String
  note String
  observedAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id])
}

model PermissionGrant {
  id String @id @default(cuid())

  action PermissionAction

  subjectPersonId String
  granterPersonId String?
  familyId String?
  profileId String?

  subjectPerson Person @relation("SubjectPermissions", fields: [subjectPersonId], references: [id])
  granterPerson Person? @relation("GrantedPermissions", fields: [granterPersonId], references: [id])
  family FamilyGroup? @relation(fields: [familyId], references: [id])
  profile Profile? @relation(fields: [profileId], references: [id])

  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([subjectPersonId, action])
  @@index([familyId])
  @@index([profileId])
}